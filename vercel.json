{
  "rewrites": [
    { "source": "/", "destination": "/src/user/index.html" },
    { "source": "/user/index.html", "destination": "/src/user/index.html" },

    { "source": "/admin/admin.html", "destination": "/src/admin/admin.html" },
    { "source": "/admin/admin.js", "destination": "/src/admin/admin.js" },
    {
      "source": "/admin/donhang.html",
      "destination": "/src/admin/donhang.html"
    },
    { "source": "/donhang.js", "destination": "/src/admin/donhang.js" },
    {
      "source": "/admin/trangchu.html",
      "destination": "/src/admin/trangchu.html"
    },

    { "source": "/user.js", "destination": "/src/user/user.js" },
    { "source": "/user-js/:file", "destination": "/src/user/user-js/:file" },
    { "source": "/css/:file", "destination": "/src/css/:file" },
    { "source": "/src/img/:file", "destination": "/src/img/:file" }
  ]
}
